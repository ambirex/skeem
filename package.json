{
  "name": "skeem-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @skeems/types && npm run build -w @skeems/directus && npm run build -w @skeems/pocketbase && npm run build -w @skeems/nocodb && npm run build -w @skeems/strapi && npm run build -w @skeems/wikidata && npm run build -w @skeems/musicbrainz && npm run build -w @skeems/osm && npm run build -w @skeems/openlibrary && npm run build -w @skeems/crossref && npm run build -w @skeems/tmdb && npm run build -w skeem && npm run build -w @skeems/mcp",
    "dev": "npm run dev --workspace skeem",
    "eval:run": "npm run build && node ./test/evals/run.mjs",
    "eval:nano-gpt:models": "node ./test/evals/providers/nano-gpt-models.mjs",
    "eval:provider:sample": "npm run build && node ./test/evals/run.mjs --case ./test/evals/cases/01-discovery-and-read.json --provider command --provider-command 'node ./test/evals/providers/sample-command-provider.mjs'",
    "eval:sample": "npm run build && node ./test/evals/run.mjs --case ./test/evals/cases/01-discovery-and-read.json --transcript ./test/evals/transcripts/01-discovery-and-read.sample.json",
    "smoke:directus": "npm run build && node ./test/smoke/directus-ls.mjs",
    "smoke:directus:ls": "npm run build && node ./test/smoke/directus-ls.mjs",
    "smoke:wikidata": "npm run build && node ./test/smoke/wikidata.mjs",
    "smoke:musicbrainz": "npm run build && node ./test/smoke/musicbrainz.mjs",
    "smoke:osm": "npm run build && node ./test/smoke/osm.mjs",
    "smoke:openlibrary": "npm run build && node ./test/smoke/openlibrary.mjs",
    "smoke:crossref": "npm run build && node ./test/smoke/crossref.mjs",
    "smoke:tmdb": "npm run build && node ./test/smoke/tmdb.mjs",
    "smoke:mcp": "npm run build && node ./test/smoke/mcp.mjs",
    "conformance": "npm run build && node ./test/conformance/run.mjs",
    "conformance:directus": "npm run build && node ./test/conformance/run.mjs --adapter directus",
    "conformance:pocketbase": "npm run build && node ./test/conformance/run.mjs --adapter pocketbase",
    "conformance:nocodb": "npm run build && node ./test/conformance/run.mjs --adapter nocodb",
    "conformance:strapi": "npm run build && node ./test/conformance/run.mjs --adapter strapi",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
