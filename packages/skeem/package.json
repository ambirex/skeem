{
  "name": "skeem",
  "version": "0.6.0",
  "description": "Relational-aware CLI for headless backends (Directus, PocketBase, NocoDB, Strapi) and public reference datasets (WikiData, TMDB, CrossRef, …), built for AI agents.",
  "license": "MIT",
  "author": "Brent Doll <brent.doll@gmail.com>",
  "homepage": "https://github.com/ambirex/skeem#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambirex/skeem.git",
    "directory": "packages/skeem"
  },
  "bugs": {
    "url": "https://github.com/ambirex/skeem/issues"
  },
  "keywords": [
    "cli",
    "ai",
    "llm",
    "agents",
    "ai-agents",
    "claude",
    "directus",
    "pocketbase",
    "nocodb",
    "strapi",
    "headless-cms",
    "schema",
    "database",
    "wikidata",
    "tmdb",
    "crossref",
    "enrichment",
    "idempotency",
    "provenance"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "skeem": "./dist/bin/skeem.js"
  },
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "node --enable-source-maps --import tsx ./bin/skeem.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@skeems/crossref": "0.6.0",
    "@skeems/directus": "0.6.0",
    "@skeems/musicbrainz": "0.6.0",
    "@skeems/nocodb": "0.6.0",
    "@skeems/openlibrary": "0.6.0",
    "@skeems/osm": "0.6.0",
    "@skeems/pocketbase": "0.6.0",
    "@skeems/strapi": "0.6.0",
    "@skeems/tmdb": "0.6.0",
    "@skeems/types": "0.6.0",
    "@skeems/wikidata": "0.6.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
